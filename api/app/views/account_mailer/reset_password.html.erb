<% reset_url = "#{@client_url}/reset-password/#{@user.reset_password_token}" %>
<% reset_url += "?account_link_token=#{@account_link_token}" if @account_link_token %>
<p>
  You recently requested to reset your password for your account on <%= @installation_name %>.
  Click the link below to reset it.
</p>
<%= render :partial => "partials/email/spacer", locals: { height: 10 } %>
<%= render :partial => "partials/email/button", locals: { text: "Reset your password", url: reset_url } %>
<%= render :partial => "partials/email/spacer", locals: { height: 10 } %>
<p>If you did not request a password reset, please ignore this email. This password reset is only valid for the next 60 minutes.</p>
